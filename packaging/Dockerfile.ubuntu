FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      dpkg-dev \
      libadwaita-1-dev \
      libgl1 \
      libglib2.0-0t64 \
      libglib2.0-bin \
      libpython3.12 \
      libsm6 \
      libxext6 \
      libxrender1 \
      libgtk-4-dev \
      pkg-config \
      python3 \
      python3-venv \
      xdg-utils \
      xvfb \
      xauth \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain 1.92.0
ENV PATH="/root/.cargo/bin:${PATH}"

RUN python3 -m venv /opt/release-venv
ENV PATH="/opt/release-venv/bin:${PATH}"

WORKDIR /project
COPY . .
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip ".[dev,packaging]"
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --locked --release --manifest-path desktop/Cargo.toml
ARG RELEASE_VERSION=1.0.0
ENV RELEASE_VERSION=${RELEASE_VERSION}
RUN python -m pytest && bash packaging/build_ubuntu.sh

FROM scratch AS artifacts
COPY --from=0 /project/dist/*.deb /
COPY --from=0 /project/dist/*.deb.sha256 /
